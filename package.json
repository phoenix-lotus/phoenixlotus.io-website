{
  "name": "phoenixlotus-portfolio",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Portfolio of Robert (Bobby) Goldberg — PhoenixLotus",
  "scripts": {
    "dev": "vite",
    "check:prices": "node scripts/check-prices.mjs",
    "prebuild": "npm run check:prices",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "gen:assets": "node scripts/gen-assets.mjs",
    "updater": "node scripts/updater/run.mjs",
    "updater:check": "node scripts/updater/run.mjs --check"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.469.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.25",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
